#!/bin/sh
# fnOS lifecycle entrypoint: start | stop | status.
set -u

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP_DEST=${TRIM_APPDEST:-$SELF_DIR/../target}
APP_VAR=${TRIM_PKGVAR:-$SELF_DIR/../.var}
BIN=$APP_DEST/pikpak
SOCK=$APP_DEST/app.sock
PIDF=$APP_VAR/pikpak.pid
LOG=$APP_VAR/logs/app.log

is_running() {
	[ -f "$PIDF" ] || return 1
	pid=$(cat "$PIDF" 2>/dev/null) || return 1
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
start)
	if is_running; then
		exit 0
	fi
	mkdir -p "$APP_VAR/logs"
	nohup "$BIN" --socket "$SOCK" >>"$LOG" 2>&1 &
	echo $! >"$PIDF"
	i=0
	while [ "$i" -lt 50 ]; do
		[ -S "$SOCK" ] && exit 0
		sleep 0.1
		i=$((i + 1))
	done
	exit 1
	;;
stop)
	if ! is_running; then
		rm -f "$PIDF" "$SOCK"
		exit 0
	fi
	pid=$(cat "$PIDF")
	kill "$pid" 2>/dev/null || true
	i=0
	while [ "$i" -lt 100 ] && kill -0 "$pid" 2>/dev/null; do
		sleep 0.1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null || true
	rm -f "$PIDF" "$SOCK"
	exit 0
	;;
status)
	if is_running; then
		exit 0
	fi
	exit 3
	;;
*)
	exit 1
	;;
esac
